# PostgreSQL connection string (Neon / Supabase free tier both work)
DATABASE_URL="postgresql://user:password@host:5432/loop?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API — keep server-side only, never expose to the browser
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-6"
